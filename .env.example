# VT Logistic Services - Environment Configuration
# To enable real outgoing SMTP emails to info@vtlogistic.in, copy this file to .env.local

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@vtlogistic.in
SMTP_PASS=your-app-password-here
SMTP_FROM="VT Logistic Services <info@vtlogistic.in>"

# Official Operations Channels
NEXT_PUBLIC_OFFICIAL_EMAIL=info@vtlogistic.in
NEXT_PUBLIC_OFFICIAL_PHONE=+919053529200
NEXT_PUBLIC_OFFICIAL_WHATSAPP=919053529200
